+# Compound surnames key on their head consistently across both catalogues:
+# "Dalla Torre" -> torre, "de Andrade" -> andrade. Only a particle SPACE-JOINED to a
+# following capitalised surname counts as a compound prefix, so a comma-separated first
+# author that merely spells a particle ("Du, Xu & Chen" -- the Chinese surname Du) is left
+# intact. The particle alternation is case-folded with an inline (?i:...) so the surname
+# class stays case-sensitive (otherwise it would swallow lower-case "et").
+_PARTICLES = r'de|del|della|dalla|van|von|da|do|dos|du|le|la|den|der|di|ten|ter|af|zu|das|dem'
+_COMPOUND = re.compile(
+    r'\b(?:(?i:%s)\s+)+([A-Z][a-z\u00C0-\u00FF\u0100-\u017F][\w\u00C0-\u024F\'’-]*)' % _PARTICLES)
+# author-run continuation tokens: initials (W. / W.Y. / C.G.), '&', 'et', 'al.'
+_CONT = re.compile(r"^(?:[A-Z]\.?(?:[- ]?[A-Z]\.?)*|&|et|al\.?|and)$")
+
+def _first_author(pre):
+    """First author of the citation whose year sits immediately after `pre`.
+
+    Walk LEFT from the year over the contiguous author run -- surnames, initials,
+    '&'/'et al.' -- and stop at the first non-author token (a lower-case epithet, a page
+    number, or a clause boundary). The FIRST surname of that run is the citation's first
+    author, which is exactly what AntCat renders as "First et al." So both catalogues key
+    on the same author however many co-authors each spells out. This replaces the old
+    nearest(=last)-surname key, which landed on whichever co-author Bolton happened to
+    print last ("Wang, W.Y., Soh, et al." -> soh) and so never matched AntCat's "wang".
+
+    Two guards keep the walk honest:
+      * split on ';' and on ':' (unless the ':' is trailing -- a stray "Author: year"), so
+        the run never crosses a citation boundary or a "combination in Genus:" target;
+      * stopping at the lower-case epithet keeps a protonym line ("Camponotus enganensis
+        Santschi, 1928") off the genus -- the failure that got first-author-of-SEGMENT
+        reverted before. Here the stop happens without a segment split, so the walk never
+        reaches back to the genus in the first place."""
+    pre = _COMPOUND.sub(r'\1', pre)
+    raw = re.split(r';|:(?!\s*$)', pre)[-1]
+    run = []
+    for tok in reversed(re.findall(r"[^\s,]+", raw)):
+        c = tok.strip(".,;:()[]\"")
+        if not c:
+            continue
+        if SURTOK.fullmatch(c) or _CONT.match(c):
+            run.append(c)
+        else:
+            break                                 # lower-case epithet / page number / boundary
+    run.reverse()
+    surs = [t for t in run if SURTOK.fullmatch(t)]
+    return surs[0] if surs else None
+
